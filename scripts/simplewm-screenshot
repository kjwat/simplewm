#!/bin/sh
set -eu
case "${1:-region}" in
    region) region=$(slurp) || exit 0 ;;
    full) region= ;;
    *) printf '%s\n' 'Usage: simplewm-screenshot [region|full]' >&2; exit 2 ;;
esac
pictures=$(xdg-user-dir PICTURES 2>/dev/null || printf '%s/Pictures' "$HOME")
folder=$pictures/Screenshots
mkdir -p "$folder"
target=$(mktemp "$folder/$(date +%Y-%m-%d_%H-%M-%S)-XXXXXX.png")
trap 'rm -f "$target"' HUP INT TERM
if [ -n "$region" ]; then grim -g "$region" "$target"; else grim "$target"; fi
wl-copy --type image/png < "$target"
notify-send -a SimpleWM -t 2500 'Screenshot copied' "Saved to $target" 2>/dev/null || true

#!/usr/bin/python3
"""Wallpaper chooser with preview, zoom, and optional matching colors."""
import io
import json
import os
from pathlib import Path
import subprocess
import threading
import gi
gi.require_version('Gtk', '3.0')
from gi.repository import Gtk, GdkPixbuf, GLib
from PIL import Image, ImageOps

state = Path(os.environ.get('XDG_STATE_HOME', Path.home() / '.local/state')) / 'simplewm-theme'
try:
    selection = json.loads((state / 'selection.json').read_text())
except (OSError, ValueError):
    selection = {'image': '/usr/local/share/backgrounds/simpleos/simpleos-background.png', 'mode': 'fill', 'zoom': 1, 'theme': True}
window = Gtk.Window(title='Wallpaper and colors')
window.set_default_size(640, 530)
window.set_border_width(18)
window.connect('destroy', Gtk.main_quit)
box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
window.add(box)
preview = Gtk.Image()
preview.set_size_request(600, 340)
box.pack_start(preview, True, True, 0)
chooser = Gtk.FileChooserButton(title='Choose a wallpaper', action=Gtk.FileChooserAction.OPEN)
filter_images = Gtk.FileFilter()
filter_images.set_name('Images')
filter_images.add_pixbuf_formats()
chooser.add_filter(filter_images)
chooser.set_filename(selection['image'])
box.pack_start(chooser, False, False, 0)
row = Gtk.Box(spacing=12)
box.pack_start(row, False, False, 0)
row.pack_start(Gtk.Label(label='Position'), False, False, 0)
mode = Gtk.ComboBoxText()
for name in ('fill', 'fit', 'center', 'stretch', 'tile'):
    mode.append(name, name.title())
mode.set_active_id(selection.get('mode', 'fill'))
row.pack_start(mode, False, False, 0)
row.pack_start(Gtk.Label(label='Zoom'), False, False, 0)
zoom = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 100, 500, 5)
zoom.set_value(selection.get('zoom', 1) * 100)
zoom.set_digits(0)
zoom.set_hexpand(True)
zoom.connect('format-value', lambda scale, value: f'{value:.0f}%')
row.pack_start(zoom, True, True, 0)
theme = Gtk.CheckButton(label='Match application colors to the wallpaper')
theme.set_active(selection.get('theme', True))
box.pack_start(theme, False, False, 0)
status = Gtk.Label(label='Choose an image, adjust the preview, then Apply.')
status.set_line_wrap(True)
status.set_xalign(0)
box.pack_start(status, False, False, 0)
buttons = Gtk.Box(spacing=10)
box.pack_start(buttons, False, False, 0)
apply = Gtk.Button(label='Apply')
undo = Gtk.Button(label='Undo last change')
close = Gtk.Button(label='Close')
buttons.pack_start(undo, False, False, 0)
buttons.pack_end(apply, False, False, 0)
buttons.pack_end(close, False, False, 0)
close.connect('clicked', lambda *_: window.destroy())


def update_preview(*_):
    filename = chooser.get_filename()
    if not filename:
        return
    try:
        with Image.open(filename) as original:
            if original.width * original.height > 42_000_000:
                raise ValueError('Image is too large (maximum 42 megapixels).')
            img = ImageOps.exif_transpose(original).convert('RGB')
            w, h = img.size
            factor = zoom.get_value() / 100
            cw, ch = max(1, round(w / factor)), max(1, round(h / factor))
            img = img.crop(((w-cw)//2, (h-ch)//2, (w+cw)//2, (h+ch)//2))
            size = (600, 338)
            selected = mode.get_active_id()
            if selected == 'fill': img = ImageOps.fit(img, size, Image.Resampling.LANCZOS)
            elif selected == 'stretch': img = img.resize(size, Image.Resampling.LANCZOS)
            elif selected == 'fit': img = ImageOps.pad(img, size, Image.Resampling.LANCZOS, color='#101313')
            else:
                canvas = Image.new('RGB', size, '#101313')
                if selected == 'tile':
                    for x in range(0, size[0], img.width):
                        for y in range(0, size[1], img.height): canvas.paste(img, (x,y))
                else: canvas.paste(img, ((size[0]-img.width)//2, (size[1]-img.height)//2))
                img = canvas
            content = io.BytesIO()
            img.save(content, 'PNG')
            loader = GdkPixbuf.PixbufLoader.new_with_type('png')
            loader.write(content.getvalue()); loader.close()
            preview.set_from_pixbuf(loader.get_pixbuf())
    except (OSError, ValueError, Image.DecompressionBombError) as error:
        status.set_text(str(error))


def run_change(args):
    apply.set_sensitive(False); undo.set_sensitive(False)
    status.set_text('Applying…')
    def finished(result):
        apply.set_sensitive(True); undo.set_sensitive(True)
        if result.returncode:
            status.set_text(result.stderr.strip() or 'The settings could not be applied.')
        else:
            status.set_text('Applied. Reopen applications to see their new colors.' if theme.get_active() else 'Wallpaper applied.')
        return False
    def worker():
        try:
            result = subprocess.run(['wallpaper-theme', *args], capture_output=True, text=True)
        except OSError as error:
            result = subprocess.CompletedProcess(args, 1, '', str(error))
        GLib.idle_add(finished, result)
    threading.Thread(target=worker, daemon=True).start()


def apply_clicked(*_):
    filename = chooser.get_filename()
    if not filename:
        status.set_text('Choose an image first.'); return
    args = ['--mode', mode.get_active_id(), '--zoom', str(zoom.get_value()/100)]
    if not theme.get_active(): args.append('--wallpaper-only')
    run_change([*args, filename])

chooser.connect('file-set', update_preview)
mode.connect('changed', update_preview)
zoom.connect('value-changed', update_preview)
apply.connect('clicked', apply_clicked)
undo.connect('clicked', lambda *_: run_change(['--rollback']))
window.show_all()
update_preview()
Gtk.main()

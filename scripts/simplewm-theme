def terminal_ansi_palette(theme: dict[str, tuple[int, int, int]]) -> list[str]:
    """Keep terminal semantics while replacing distro-blue with the wallpaper accent."""
    colors = (
        theme["surface2"], theme["error"], theme["accent"], theme["accent_hover"],
        theme["accent"], theme["accent"], theme["accent_hover"], theme["foreground"],
        theme["muted"], theme["error"], theme["accent"], theme["accent_hover"],
        theme["accent"], theme["accent_hover"], theme["accent_hover"], theme["foreground"],
    )
    return [hexcolor(color) for color in colors]

def firefox_profile_dirs() -> list[Path]:
    """Return declared Firefox profiles without guessing from cache directories."""
    roots = [HOME / ".mozilla/firefox", HOME / ".mozilla/firefox-esr"]
    profiles: list[Path] = []
    for root in roots:
        profiles_ini = root / "profiles.ini"
        if not profiles_ini.is_file():
            continue
        parser = configparser.ConfigParser(interpolation=None)
        try:
            parser.read(profiles_ini, encoding="utf-8")
        except (OSError, configparser.Error):
            continue
        for section in parser.sections():
            if not section.startswith("Profile") or not parser.has_option(section, "Path"):
                continue
            candidate = Path(parser.get(section, "Path")).expanduser()
            if parser.getboolean(section, "IsRelative", fallback=True):
                candidate = root / candidate
            if candidate.is_dir():
                profiles.append(candidate)
    return unique_paths(profiles)

def set_firefox_user_pref(path: Path, name: str, value: str) -> None:
    line = f'user_pref({json.dumps(name)}, {value});'
    text = path.read_text(encoding="utf-8") if path.exists() else ""
    pattern = re.compile(
        rf'^\s*user_pref\(\s*{re.escape(json.dumps(name))}\s*,.*?\);\s*$',
        re.MULTILINE,
    )
    if pattern.search(text):
        updated = pattern.sub(line, text)
    else:
        updated = text + ("" if not text or text.endswith("\n") else "\n") + line + "\n"
    if updated != text:
        backup_once(path)
        atomic_write(path, updated)

def write_firefox(theme: dict[str, tuple[int, int, int]]) -> int:
    """Install live system-color Firefox chrome rules; first use needs a restart."""
    c = {name: hexcolor(value) for name, value in theme.items()}
    css = f'''/* Generated by wallpaper-theme. Do not edit by hand.
 * Last generated palette: background {c['background']}, foreground {c['foreground']},
 * accent {c['accent']}.  Rules use live system colors so future wallpaper-theme
 * runs propagate through GTK without requiring another Firefox restart. */
:root {{
  --wallpaper-theme-background: Canvas;
  --wallpaper-theme-surface: color-mix(in srgb, CanvasText 7.5%, Canvas);
  --wallpaper-theme-surface-2: color-mix(in srgb, CanvasText 14%, Canvas);
  --wallpaper-theme-foreground: CanvasText;
  --wallpaper-theme-accent: AccentColor;
  --wallpaper-theme-accent-foreground: AccentColorText;
  --focus-outline-color: var(--wallpaper-theme-accent) !important;
  --toolbar-bgcolor: var(--wallpaper-theme-surface) !important;
  --toolbar-color: var(--wallpaper-theme-foreground) !important;
  --toolbar-field-background-color: var(--wallpaper-theme-background) !important;
  --toolbar-field-color: var(--wallpaper-theme-foreground) !important;
  --toolbar-field-border-color: var(--wallpaper-theme-surface-2) !important;
  --toolbar-field-focus-background-color: var(--wallpaper-theme-background) !important;
  --toolbar-field-focus-color: var(--wallpaper-theme-foreground) !important;
  --toolbar-field-focus-border-color: var(--wallpaper-theme-accent) !important;
  --toolbarbutton-icon-fill-attention: var(--wallpaper-theme-accent) !important;
  --urlbarView-highlight-background: var(--wallpaper-theme-accent) !important;
  --urlbarView-highlight-color: var(--wallpaper-theme-accent-foreground) !important;
  --tab-selected-bgcolor: var(--wallpaper-theme-surface-2) !important;
  --lwt-accent-color: var(--wallpaper-theme-background) !important;
  --lwt-text-color: var(--wallpaper-theme-foreground) !important;
  accent-color: var(--wallpaper-theme-accent) !important;
}}

#navigator-toolbox,
#TabsToolbar,
#nav-bar,
#PersonalToolbar {{
  background-color: var(--wallpaper-theme-surface) !important;
  color: var(--wallpaper-theme-foreground) !important;
}}

#urlbar-background,
#searchbar {{
  background-color: var(--wallpaper-theme-background) !important;
  color: var(--wallpaper-theme-foreground) !important;
  border-color: var(--wallpaper-theme-surface-2) !important;
}}

#urlbar[focused] > #urlbar-background,
#urlbar[open] > #urlbar-background,
#searchbar:focus-within {{
  border-color: var(--wallpaper-theme-accent) !important;
  outline: 1px solid var(--wallpaper-theme-accent) !important;
  outline-offset: -1px !important;
  box-shadow: 0 0 0 1px var(--wallpaper-theme-accent) !important;
}}

.tabbrowser-tab[selected] .tab-background {{
  background-color: var(--wallpaper-theme-surface-2) !important;
  box-shadow: inset 0 -2px var(--wallpaper-theme-accent) !important;
}}

#urlbarView .urlbarView-row[selected] > .urlbarView-row-inner {{
  background-color: var(--wallpaper-theme-accent) !important;
  color: var(--wallpaper-theme-accent-foreground) !important;
}}
'''
    count = 0
    import_line = '@import url("wallpaper-theme.css");'
    for profile in firefox_profile_dirs():
        chrome = profile / "chrome"
        generated = chrome / "wallpaper-theme.css"
        if generated.exists():
            existing = generated.read_text(encoding="utf-8", errors="replace")
            if not existing.startswith("/* Generated by wallpaper-theme."):
                print(
                    f"wallpaper-theme: warning: refusing unrelated Firefox CSS: {generated}",
                    file=sys.stderr,
                )
                continue
        backup_once(generated)
        atomic_write(generated, css)
        user_chrome = chrome / "userChrome.css"
        text = user_chrome.read_text(encoding="utf-8") if user_chrome.exists() else ""
        if import_line not in text:
            backup_once(user_chrome)
            atomic_write(user_chrome, import_line + "\n" + text)
        set_firefox_user_pref(
            profile / "user.js",
            "toolkit.legacyUserProfileCustomizations.stylesheets",
            "true",
        )
        count += 1
    return count

def refresh():
    if os.environ.get('SIMPLEWM_SOCKET'):
        result=subprocess.run(['simplewmctl','reload'],capture_output=True,text=True)
        if result.returncode:
            raise RuntimeError(result.stdout or result.stderr)
    if os.environ.get('DISPLAY'):
        resources=CONFIG / 'simplewm/colors.Xresources'
        if resources.exists():
            subprocess.run(['xrdb','-merge',str(resources)],check=False)

def rollback():
    backup=STATE / 'previous'
    index=backup / 'files.json'
    if not index.exists():
        raise RuntimeError('no previous theme to restore')
    for name,key in json.loads(index.read_text()).items():
        path=Path(name)
        if key is None:
            path.unlink(missing_ok=True)
        else:
            path.parent.mkdir(parents=True,exist_ok=True)
            shutil.copy2(backup / key,path)
    refresh()
    print('Previous wallpaper and colors restored.')

def apply_image(source, mode, wallpaper_only=False):
    source=Path(source).expanduser().resolve(strict=True)
    with Image.open(source) as image:
        if image.width*image.height>42_000_000:
            raise RuntimeError('wallpaper exceeds the 42 megapixel limit')
        image=ImageOps.exif_transpose(image).convert('RGB')
        image.thumbnail((10000,10000),Image.Resampling.LANCZOS)
        clusters=quantize(list(image.resize((96,96)).getdata()))
        theme=choose_colors(clusters)
        validate_foreground_invariant(theme,clusters)
        state=STATE / 'previous'
        if state.exists():
            shutil.rmtree(state)
        current=DATA / 'wallpapers/current.png'
        backup_once(current)
        current.parent.mkdir(parents=True,exist_ok=True)
        with tempfile.NamedTemporaryFile(dir=current.parent,suffix='.png',delete=False) as temp:
            temporary=Path(temp.name)
        image.save(temporary,'PNG')
        temporary.chmod(0o600)
        temporary.replace(current)
    config=CONFIG / 'simplewm/config'
    if not config.exists():
        config.parent.mkdir(parents=True,exist_ok=True)
        shutil.copy2('/usr/local/share/simplewm/config',config)
    backup_once(config)
    palette=CONFIG / 'simplewm/palette.conf'
    backup_once(palette)
    previous=palette.read_text() if palette.exists() else ''
    lines=['# Generated by simplewm-theme; fonts remain in the main config.',
           'background '+json.dumps(str(current),ensure_ascii=False)+' '+mode]
    if wallpaper_only:
        lines.extend(line for line in previous.splitlines() if line.startswith('color '))
    if not wallpaper_only:
        for name,key in [('background','background'),('inactive','surface2'),('focused','accent'),('urgent','error')]:
            lines.append('color '+name+' '+hexcolor(theme[key]))
    atomic_write(palette,'\n'.join(lines)+'\n')
    include='include palette.conf'
    text=config.read_text()
    if include not in text.splitlines():
        atomic_write(config,text.rstrip()+'\n\n'+include+'\n')
    check=subprocess.run(['simplewm','--check-config','-c',str(config)],capture_output=True,text=True)
    if check.returncode:
        rollback()
        raise RuntimeError(check.stderr)
    if not wallpaper_only:
        ansi=terminal_ansi_palette(theme)
        ini=CONFIG / 'simpleterm/settings.ini'
        backup_once(ini)
        term=configparser.ConfigParser(interpolation=None)
        if ini.exists():
            term.read(ini)
        if 'Colors' not in term:
            term['Colors']={}
        def rgb(color): return 'rgb('+','.join(str(v) for v in color)+')'
        term['Colors'].update({'use-theme-colors':'false','foreground':rgb(theme['foreground']),
            'background':rgb(theme['background']),'custom-cursor':'true','cursor':rgb(theme['accent']),
            'cursor-foreground':rgb(theme['accent_fg']),'custom-highlight':'true',
            'highlight':rgb(theme['accent']),'highlight-foreground':rgb(theme['accent_fg'])})
        for index,color in enumerate(ansi):
            term['Colors'][f'palette-{index}']=rgb(tuple(int(color[o:o+2],16) for o in (1,3,5)))
        import io
        out=io.StringIO(); term.write(out); atomic_write(ini,out.getvalue())
        for toolkit in ('gtk-3.0','gtk-4.0'):
            css=CONFIG / toolkit / 'simplewm-palette.css'
            backup_once(css); atomic_write(css,gtk_css(theme))
            user=CONFIG / toolkit / 'gtk.css'
            backup_once(user)
            text=user.read_text() if user.exists() else ''
            include='@import url("simplewm-palette.css");'
            if include not in text:
                atomic_write(user,include+'\n'+text)
        fuzzel=CONFIG / 'simplewm/fuzzel.ini'
        backup_once(fuzzel)
        launcher=configparser.ConfigParser(interpolation=None)
        if fuzzel.exists(): launcher.read(fuzzel)
        if 'main' not in launcher:
            font=re.sub(r' ([0-9]+(?:\.[0-9]+)?)$',r':size=\1',os.environ.get('SIMPLEWM_FONT','Ubuntu Sans 11'))
            launcher['main']={'font':font,'width':'42','lines':'9'}
        launcher['colors']={
            'background':hexcolor(theme['background'])[1:]+'ee','text':hexcolor(theme['foreground'])[1:]+'ff',
            'match':hexcolor(theme['accent_hover'])[1:]+'ff','selection':hexcolor(theme['accent'])[1:]+'ff',
            'selection-text':hexcolor(theme['foreground'])[1:]+'ff','border':hexcolor(theme['accent'])[1:]+'ff'}
        out=io.StringIO(); launcher.write(out); atomic_write(fuzzel,out.getvalue())
        resources=CONFIG / 'simplewm/colors.Xresources'
        backup_once(resources)
        lines=[f'*.background: {hexcolor(theme["background"])}',f'*.foreground: {hexcolor(theme["foreground"])}',
               f'*.cursorColor: {hexcolor(theme["accent"])}']
        lines.extend(f'*.color{i}: {color}' for i,color in enumerate(ansi))
        atomic_write(resources,'\n'.join(lines)+'\n')
        write_firefox(theme)
        palette_json=CONFIG / 'simplewm/palette.json'
        backup_once(palette_json); atomic_write(palette_json,json.dumps({k:hexcolor(v) for k,v in theme.items()}))
    refresh()
    print(f'Wallpaper: {source}\nMode: {mode}\nAccent: {hexcolor(theme["accent"])}')
    print('SimpleWM, GTK, launcher, Simpleterm, Xwayland, and existing Firefox profiles use the palette.')
    print('Reopen Simpleterm and Firefox for their first palette change. Fonts are preserved. Undo: wallpaper-theme --rollback')

def main():
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('image',nargs='?')
    parser.add_argument('--mode',choices=['fit','fill','center','stretch','tile'],default='fit')
    parser.add_argument('--wallpaper-only',action='store_true')
    parser.add_argument('--wizard',action='store_true')
    parser.add_argument('--rollback',action='store_true')
    parser.add_argument('--startup',action='store_true')
    parser.add_argument('--doctor',action='store_true')
    parser.add_argument('--version',action='version',version='wallpaper-theme SimpleWM 1.0 (palette engine 3.8)')
    args=parser.parse_args()
    if args.rollback:
        rollback(); return
    if args.startup:
        refresh(); return
    if args.doctor:
        missing=[p for p in ['simplewm','simplewmctl','swaybg'] if not shutil.which(p)]
        if missing: raise RuntimeError('missing: '+', '.join(missing))
        print('OK SimpleWM, wallpaper setter, Pillow, and palette engine'); return
    if args.wizard or not args.image:
        args.image=input('Wallpaper image (path): ').strip()
        args.mode=input(f'Mode: fit / fill / center / stretch / tile [{args.mode}]: ').strip() or args.mode
        if args.mode not in ('fit','fill','center','stretch','tile'): raise RuntimeError('invalid display mode')
    if not args.image: return
    apply_image(args.image,args.mode,args.wallpaper_only)

if __name__=='__main__':
    try:
        main()
    except (OSError,RuntimeError,ValueError,Image.DecompressionBombError,subprocess.CalledProcessError) as error:
        sys.exit(f'wallpaper-theme: {error}')

#!/usr/bin/python3
"""Wallpaper and palette portions of Keelan's wallpaper-theme-dwm.sh, adapted
for SimpleWM. The original palette and legibility rules are retained. Fonts
are managed exclusively by SimpleWM's config; this tool never installs fonts.
"""
from __future__ import annotations
import argparse
import colorsys
import configparser
import hashlib
import json
import math
import os
from pathlib import Path
import random
import re
import shutil
import subprocess
import sys
import tempfile
from PIL import Image, ImageOps
HOME=Path.home()
CONFIG=Path(os.environ.get('XDG_CONFIG_HOME', HOME / '.config'))
DATA=Path(os.environ.get('XDG_DATA_HOME', HOME / '.local/share'))
STATE=Path(os.environ.get('XDG_STATE_HOME', HOME / '.local/state')) / 'simplewm-theme'
FOREGROUND_LUMINANCE_THRESHOLD=math.sqrt(0.05 * 1.05) - 0.05

def atomic_write(path: Path, contents: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(mode='w', dir=path.parent, prefix='.'+path.name, delete=False) as out:
        out.write(contents)
        temporary=Path(out.name)
    temporary.chmod(0o600)
    temporary.replace(path)

def backup_once(path: Path) -> None:
    backup=STATE / 'previous'
    backup.mkdir(parents=True, exist_ok=True)
    index=backup / 'files.json'
    records=json.loads(index.read_text()) if index.exists() else {}
    name=str(path)
    if name in records:
        return
    key=hashlib.sha256(name.encode()).hexdigest()
    records[name]=key if path.exists() else None
    if path.exists():
        shutil.copy2(path,backup / key)
    atomic_write(index,json.dumps(records,indent=2))

def unique_paths(paths):
    return list(dict.fromkeys(paths))

# Palette functions retained from wallpaper-theme 3.8.
def quantize(pixels: list[tuple[int, int, int]], count: int = 12) -> list[tuple[tuple[int, int, int], int]]:
    bins: dict[tuple[int, int, int], int] = {}
    for red, green, blue in pixels:
        key = (red // 8 * 8 + 4, green // 8 * 8 + 4, blue // 8 * 8 + 4)
        bins[key] = bins.get(key, 0) + 1
    points = list(bins)
    weights = [bins[point] for point in points]
    if not points:
        raise SystemExit("wallpaper-theme: wallpaper has no opaque pixels")
    if len(points) <= count:
        return sorted(zip(points, weights), key=lambda item: item[1], reverse=True)
    rng = random.Random(0xD00D)
    centroids: list[tuple[float, float, float]] = [tuple(map(float, points[weights.index(max(weights))]))]
    while len(centroids) < count:
        scores = []
        for point, weight in zip(points, weights):
            distance = min(sum((point[channel] - center[channel]) ** 2 for channel in range(3)) for center in centroids)
            scores.append(distance * math.sqrt(weight))
        target = rng.random() * sum(scores)
        running = 0.0
        selected = points[-1]
        for point, score in zip(points, scores):
            running += score
            if running >= target:
                selected = point
                break
        centroids.append(tuple(map(float, selected)))
    cluster_weights = [0] * count
    for _ in range(18):
        cluster_weights = [0] * count
        sums = [[0.0, 0.0, 0.0] for _ in range(count)]
        for point, weight in zip(points, weights):
            cluster = min(range(count), key=lambda candidate: sum((point[channel] - centroids[candidate][channel]) ** 2 for channel in range(3)))
            cluster_weights[cluster] += weight
            for channel in range(3):
                sums[cluster][channel] += point[channel] * weight
        updated = [tuple(value / cluster_weights[cluster] for value in sums[cluster]) if cluster_weights[cluster] else centroids[cluster] for cluster in range(count)]
        movement = sum(sum((centroids[i][c] - updated[i][c]) ** 2 for c in range(3)) for i in range(count))
        centroids = updated
        if movement < 1.0:
            break
    result = [(tuple(round(channel) for channel in center), weight) for center, weight in zip(centroids, cluster_weights) if weight]
    return sorted(result, key=lambda item: item[1], reverse=True)

def luminance(color: tuple[int, int, int]) -> float:
    channels = []
    for value in color:
        channel = value / 255
        channels.append(channel / 12.92 if channel <= 0.04045 else ((channel + 0.055) / 1.055) ** 2.4)
    return 0.2126 * channels[0] + 0.7152 * channels[1] + 0.0722 * channels[2]

def binary_foreground(perceived_luminance: float) -> tuple[int, int, int]:
    """Choose the higher-contrast binary foreground for one luminance value."""
    # Black and white have equal WCAG contrast at this relative luminance.
    return (
        (0, 0, 0)
        if perceived_luminance > FOREGROUND_LUMINANCE_THRESHOLD
        else (255, 255, 255)
    )

def terminal_foreground(background: tuple[int, int, int]) -> tuple[int, int, int]:
    """Keep terminal text on the existing adaptive black/white policy."""
    return binary_foreground(luminance(background))

def palette_luminance(clusters: list[tuple[tuple[int, int, int], int]]) -> float:
    """Return the pixel-weighted luminance of the complete extracted palette."""
    total_weight = sum(weight for _, weight in clusters)
    if not total_weight:
        raise SystemExit("wallpaper-theme: wallpaper palette has no weight")
    return sum(luminance(color) * weight for color, weight in clusters) / total_weight

def palette_foreground(clusters: list[tuple[tuple[int, int, int], int]]) -> tuple[int, int, int]:
    """Choose one foreground for the whole UI from the overall palette."""
    return binary_foreground(palette_luminance(clusters))

def saturation(color: tuple[int, int, int]) -> float:
    return colorsys.rgb_to_hsv(*(channel / 255 for channel in color))[1]

def mix(first: tuple[int, int, int], second: tuple[int, int, int], amount: float) -> tuple[int, int, int]:
    return tuple(round(a * (1 - amount) + b * amount) for a, b in zip(first, second))

def contrast_ratio(first: tuple[int, int, int], second: tuple[int, int, int]) -> float:
    lighter, darker = sorted((luminance(first), luminance(second)), reverse=True)
    return (lighter + 0.05) / (darker + 0.05)

def mix_until_contrast(
    color: tuple[int, int, int],
    against: tuple[int, int, int],
    toward: tuple[int, int, int],
    minimum: float,
) -> tuple[int, int, int]:
    """Make the smallest blend toward an endpoint that reaches a contrast target."""
    if contrast_ratio(color, against) >= minimum:
        return color
    if contrast_ratio(toward, against) < minimum:
        return toward
    low, high = 0.0, 1.0
    for _ in range(18):
        middle = (low + high) / 2
        if contrast_ratio(mix(color, toward, middle), against) >= minimum:
            high = middle
        else:
            low = middle
    return mix(color, toward, high)

def hexcolor(color: tuple[int, int, int]) -> str:
    return "#{:02x}{:02x}{:02x}".format(*color)

def choose_colors(clusters: list[tuple[tuple[int, int, int], int]]) -> dict[str, tuple[int, int, int]]:
    colors = [color for color, _ in clusters]
    maximum_weight = max(weight for _, weight in clusters)
    dark = min(colors, key=lambda color: luminance(color) + saturation(color) * 0.025)
    background = mix(dark, (0, 0, 0), 0.18)
    # This desktop theme is deliberately dark.  Very bright/flat wallpapers may
    # contain no dark cluster, so progressively tint the base instead of pairing
    # black text with a background that only happened to be selected as "darkest".
    while luminance(background) > 0.018:
        background = mix(background, (0, 0, 0), 0.12)
    foreground = terminal_foreground(background)
    light_candidates = [color for color in colors if luminance(color) > 0.38]
    if light_candidates:
        palette_light = max(light_candidates, key=lambda color: luminance(color) - saturation(color) * 0.18)
        palette_light = mix(palette_light, (245, 247, 244), 0.35)
    else:
        palette_light = (225, 230, 225)
    candidates = []
    for color, weight in clusters:
        light = luminance(color)
        sat = saturation(color)
        hue = colorsys.rgb_to_hsv(*(channel / 255 for channel in color))[0]
        if 0.035 < light < 0.68 and sat > 0.12:
            score = sat * 0.62 + min(light, 0.32) * 0.34 + (weight / maximum_weight) * 0.18
            if 0.015 < hue < 0.12 and 0.15 < sat < 0.68:
                score *= 0.36
            candidates.append((score, color))
    accent = max(candidates)[1] if candidates else mix(palette_light, background, 0.45)
    surface = mix(background, palette_light, 0.075)
    surface2 = mix(background, palette_light, 0.14)
    muted = mix(palette_light, background, 0.43)
    accent = mix_until_contrast(accent, background, palette_light, 3.05)
    accent = mix_until_contrast(accent, foreground, background, 4.55)
    accent_hover = mix(accent, palette_light, 0.18)
    accent_hover = mix_until_contrast(accent_hover, foreground, background, 4.55)
    error_candidates = [
        color for color in colors
        if colorsys.rgb_to_hsv(*(channel / 255 for channel in color))[0] < 0.10
        and saturation(color) > 0.22 and luminance(color) > 0.08
    ]
    error = max(error_candidates, key=saturation) if error_candidates else (190, 92, 92)
    error = mix_until_contrast(error, foreground, background, 4.55)
    return {
        "background": background, "surface": surface, "surface2": surface2,
        "foreground": foreground, "muted": muted,
        "_palette_light": palette_light, "accent": accent,
        "accent_hover": accent_hover, "accent_fg": foreground,
        "error": error,
    }

def validate_foreground_invariant(
    theme: dict[str, tuple[int, int, int]],
    clusters: list[tuple[tuple[int, int, int], int]],
) -> None:
    """Require readable dark-theme surfaces and a coherent binary foreground."""
    if not clusters:
        raise SystemExit("wallpaper-theme: cannot validate an empty wallpaper palette")
    foreground = theme["foreground"]
    if foreground not in ((0, 0, 0), (255, 255, 255)):
        raise SystemExit("wallpaper-theme: global UI foreground is not pure black or white")
    if foreground != terminal_foreground(theme["background"]) or theme["accent_fg"] != foreground:
        raise SystemExit("wallpaper-theme: global UI foreground invariant was violated")
    if contrast_ratio(theme["background"], foreground) < 4.5:
        raise SystemExit("wallpaper-theme: background/foreground contrast is too low")
    if contrast_ratio(theme["accent"], theme["background"]) < 3.0:
        raise SystemExit("wallpaper-theme: accent/background contrast is too low")
    if contrast_ratio(theme["accent"], theme["accent_fg"]) < 4.5:
        raise SystemExit("wallpaper-theme: accent text contrast is too low")

def gtk_css(theme: dict[str, tuple[int, int, int]]) -> str:
    c = {name: hexcolor(value) for name, value in theme.items()}
    return f"""/* Generated by wallpaper-theme. */
@define-color theme_bg_color {c['background']};
@define-color theme_fg_color {c['foreground']};
@define-color theme_base_color {c['background']};
@define-color theme_text_color {c['foreground']};
@define-color theme_selected_bg_color {c['accent']};
@define-color theme_selected_fg_color {c['accent_fg']};
@define-color insensitive_bg_color {c['surface']};
@define-color insensitive_fg_color {c['foreground']};
@define-color borders {c['surface2']};
@define-color warning_color {c['foreground']};

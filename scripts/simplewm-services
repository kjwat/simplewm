#!/bin/sh
set -u
# Xwayland is started lazily by the compositor, so Xsession never loads its
# resources. Retain them when the last X11 application exits, too.
if [ -n "${DISPLAY:-}" ] && command -v xrdb >/dev/null 2>&1; then
    for resources in /etc/X11/Xresources/* "$HOME/.Xresources"; do
        [ ! -f "$resources" ] || xrdb -retain -merge "$resources" 2>/dev/null || true
    done
fi
dbus-update-activation-environment --systemd WAYLAND_DISPLAY DISPLAY SIMPLEWM_SOCKET \
    XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE DESKTOP_SESSION \
    XCURSOR_THEME XCURSOR_SIZE MOZ_ENABLE_WAYLAND GDK_DPI_SCALE 2>/dev/null || true
systemctl --user import-environment WAYLAND_DISPLAY DISPLAY SIMPLEWM_SOCKET \
    XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE DESKTOP_SESSION GDK_DPI_SCALE 2>/dev/null || true
systemctl --user start --no-block pipewire.socket pipewire-pulse.socket wireplumber.service 2>/dev/null || true
gnome-keyring-daemon --start --components=secrets >/dev/null 2>&1 || true
for agent in /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1 \
    /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 \
    /usr/libexec/polkit-mate-authentication-agent-1; do
    if [ -x "$agent" ]; then "$agent" >/dev/null 2>&1 & break; fi
done
# Idle inhibition (e.g. Firefox playing video) is honored by the compositor.
# Short notifications provide screenshot and update feedback.
# The image already supplies XFCE's notification service through D-Bus.
# Reuse that service rather than competing for org.freedesktop.Notifications.
exec swayidle -w timeout 900 'simplewm-lock' \
    timeout 1200 'wlopm --off "*"' \
    resume 'wlopm --on "*"' before-sleep 'simplewm-lock'

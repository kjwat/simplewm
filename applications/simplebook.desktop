[Desktop Entry]
Type=Application
Name=SimpleBook
GenericName=Terminal document reader
Exec=simpleterm -e simplebook %f
TryExec=simplebook
Icon=utilities-terminal
Terminal=false
Categories=Office;Viewer;
MimeType=application/epub+zip;application/x-mobipocket-ebook;application/vnd.amazon.ebook;
Keywords=read;ebook;epub;kindle;
